{
  "name": "gemini-desktop",
  "version": "@@VERSION@@",
  "description": "Unofficial Web app for Google Gemini providing the desktop user experience you would expect on Ubuntu or any other Linux desktop",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "kenvandine",
  "license": "GPL-3.0",
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.github.kenvandine.gemini-desktop",
    "productName": "Gemini",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.html",
      "*.js",
      "icon.png",
      "icon512.png"
    ],
    "linux": {
      "target": "AppImage",
      "maintainer": "kenvandine",
      "vendor": "kenvandine",
      "desktop": {
        "Name": "Gemini",
        "Comment": "Google Gemini",
        "Icon": "icon.png",
        "Categories": "Accessories;"
      }
    }
  }
}